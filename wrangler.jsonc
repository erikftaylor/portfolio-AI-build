{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-site",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "AI_FEATURES_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true
  },
  // Staging: a separate Worker (own workers.dev URL, not bound to
  // etaylor.co) for checking a change before it goes live. Deploy here
  // first with `npm run worker:staging`, look it over, then
  // `npm run worker:deploy` to promote the same build to production.
  "env": {
    "staging": {
      "name": "portfolio-site-staging",
      "vars": {
        "AI_FEATURES_ENABLED": "false"
      },
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
        ]
      }
    }
  }
}
