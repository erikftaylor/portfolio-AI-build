{
  "parchment": {
    "color": {
      "surface": {
        "canvas": { "$type": "color", "$value": "{color.paper.100}" },
        "raised": { "$type": "color", "$value": "{color.paper.50}" },
        "subtle": { "$type": "color", "$value": "{color.paper.200}" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "{color.plum.900}" },
        "secondary": { "$type": "color", "$value": "{color.plum.400}" },
        "tertiary": { "$type": "color", "$value": "{color.plum.300}" }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "{color.paper.400}" },
        "strong": { "$type": "color", "$value": "{color.plum.300}" }
      },
      "link": {
        "foreground": { "$type": "color", "$value": "{color.text.primary}" },
        "decoration": { "$type": "color", "$value": "{color.text.primary}" }
      },
      "focus": { "ring": { "$type": "color", "$value": "{color.signal.research}" } },
      "action": {
        "primary": {
          "background": { "$type": "color", "$value": "{color.plum.700}" },
          "foreground": { "$type": "color", "$value": "{color.paper.100}" },
          "hover": { "$type": "color", "$value": "{color.plum.900}" },
          "active": { "$type": "color", "$value": "{color.plum.800}" }
        },
        "disabled": {
          "background": { "$type": "color", "$value": "{color.paper.300}" },
          "foreground": { "$type": "color", "$value": "{color.plum.300}" }
        },
        "secondary": {
          "background": { "$type": "color", "$value": "{color.transparent}" },
          "foreground": { "$type": "color", "$value": "{color.text.primary}" },
          "border": { "$type": "color", "$value": "{color.border.strong}" }
        }
      },
      "selection": {
        "background": { "$type": "color", "$value": "{color.paper.300}" },
        "foreground": { "$type": "color", "$value": "{color.text.primary}" }
      },
      "status": {
        "info": { "$type": "color", "$value": "{color.status.parchment.info}" },
        "success": { "$type": "color", "$value": "{color.status.parchment.success}" },
        "warning": { "$type": "color", "$value": "{color.status.parchment.warning}" },
        "danger": { "$type": "color", "$value": "{color.status.parchment.danger}" }
      }
    }
  },
  "aubergine": {
    "color": {
      "surface": {
        "canvas": { "$type": "color", "$value": "{color.plum.700}" },
        "raised": { "$type": "color", "$value": "{color.plum.600}" },
        "subtle": { "$type": "color", "$value": "{color.plum.500}" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "{color.paper.100}" },
        "secondary": { "$type": "color", "$value": "{color.inverse.secondary}" },
        "tertiary": { "$type": "color", "$value": "{color.inverse.tertiary}" }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "{color.inverse.border}" },
        "strong": { "$type": "color", "$value": "{color.inverse.secondary}" }
      },
      "link": {
        "foreground": { "$type": "color", "$value": "{color.text.primary}" },
