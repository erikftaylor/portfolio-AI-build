# RAG — Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# RAG — OpenAI Embeddings (platform.openai.com → API Keys)
OPENAI_API_KEY=sk-xxx

# Worker runtime security. For `wrangler dev`, copy these to `.dev.vars`.
# Paid AI routes remain unavailable unless this exact value is true.
AI_FEATURES_ENABLED=false
RATE_LIMIT_SALT=replace-with-a-random-secret-at-least-32-characters
OPS_DASHBOARD_SECRET=replace-with-a-strong-dashboard-password
OPS_SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-characters
